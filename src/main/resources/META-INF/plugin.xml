<idea-plugin>
    <id>com.cursoragent.plugin</id>
    <name>Cursor in Android Studio</name>
    <vendor email="dev@example.com">SelfRegi</vendor>
    <description><![CDATA[
        Use Cursor Agent inside Android Studio with an integrated chat tool window.
        Android Studio 上で Cursor Agent CLI を利用するツールウィンドウプラグイン。
        agent -p --output-format stream-json をサブプロセス実行し、チャット UI にストリーミング表示します。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Optional: only @terminal mention support needs this. A user who has disabled the
         bundled Terminal plugin must still be able to load and use the rest of this plugin. -->
    <depends optional="true" config-file="cursor-agent-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <!-- Keep chat and browser recovery available without a JCEF provider. -->
    <depends optional="true" config-file="cursor-agent-jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorActionHandler action="EditorPaste" implementationClass="com.cursoragent.ui.composer.image.PromptImagePasteHandler"/>
        <editorActionHandler action="EditorUp" implementationClass="com.cursoragent.ui.composer.PromptQueueNavigation$Up"/>
        <editorActionHandler action="EditorDown" implementationClass="com.cursoragent.ui.composer.PromptQueueNavigation$Down"/>
        <!-- Keep persisted IDs stable when renaming the product. -->
        <notificationGroup id="Cursor Agent" displayType="BALLOON"
                           bundle="messages.CursorAgentBundle" key="notification.group.name"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.cursoragent.settings.AgentSettingsConfigurable"
                id="com.cursoragent.settings.AgentSettingsConfigurable"
                displayName="Cursor in Android Studio"/>
        <toolWindow
                id="Cursor Agent"
                anchor="right"
                icon="/icons/cursor-agent.svg"
                factoryClass="com.cursoragent.toolwindow.CursorAgentToolWindowFactory"/>
        <toolWindow
                id="Cursor Manual Browser"
                anchor="bottom"
                icon="/icons/cursor-agent.svg"
                canCloseContents="true"
                doNotActivateOnStart="true"
                factoryClass="com.cursoragent.ui.browser.ManualBrowser"/>
        <projectService serviceImplementation="com.cursoragent.service.AgentProcessService"/>
        <projectService serviceImplementation="com.cursoragent.service.CheckpointService"/>
        <projectService serviceImplementation="com.cursoragent.settings.CheckpointHistoryState"/>
        <projectService serviceImplementation="com.cursoragent.settings.ChatHistoryState"/>
        <applicationService serviceImplementation="com.cursoragent.settings.AgentSettingsState"/>
    </extensions>
    <actions>
        <action id="CursorAgent.AddSelectionToChat" class="com.cursoragent.actions.AddSelectionToChatAction"
                text="Add to Chat (Cursor)" description="選択したコードを現在のチャットへ明示contextとして追加します。">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <group id="CursorAgent.PanelActions" text="Cursor in Android Studio">
            <action id="CursorAgent.TogglePanel" class="com.cursoragent.actions.AgentWindowAction$Toggle"
                    text="Agentパネルの表示切替" description="会話と実行を保持したまま、Agentパネルを表示・非表示にします。">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt J"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt J" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt J" replace-all="true"/>
            </action>
            <action id="CursorAgent.SwapPanelSide" class="com.cursoragent.actions.AgentWindowAction$SwapSide"
                    text="Agentパネルを反対側へ移動" description="Agentパネルの配置を左・右に切り替えて表示します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control E"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta E" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta E" replace-all="true"/>
            </action>
            <action id="CursorAgent.OpenChat" class="com.cursoragent.actions.AgentWindowAction$OpenChat"
                    text="チャットを開く" description="現在のチャットを開いて選択コードを追加します。パネルにfocusがある場合は隠します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control L"/>
                <keyboard-shortcut keymap="$default" first-keystroke="control I"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta L" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta I"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta L" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta I"/>
            </action>
            <action id="CursorAgent.FollowUp" class="com.cursoragent.actions.AgentWindowAction$FollowUp"
                    text="チャットの入力へ戻る" description="現在のチャットに選択コードを追加して入力欄へ戻ります。">
                <keyboard-shortcut keymap="$default" first-keystroke="control shift Y"/>
                <keyboard-shortcut keymap="Default for XWin" first-keystroke="control Y" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta Y" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta Y" replace-all="true"/>
            </action>
            <action id="CursorAgent.NewAgent" class="com.cursoragent.actions.AgentWindowAction$NewAgent"
                    text="New Agent" description="空のAgentを再利用または作成します。focus済みの空Agentではパネルを隠します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control shift L"/>
                <keyboard-shortcut keymap="$default" first-keystroke="control shift I"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift L" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift I"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift L" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift I"/>
            </action>
            <action id="CursorAgent.AllChats" class="com.cursoragent.actions.AgentWindowAction$AllChats"
                    text="All Agents" description="チャット一覧を表示して名前・冒頭文で検索します。一覧表示中にパネル内から実行すると一覧を隠します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control shift SLASH"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control shift S" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control shift S" replace-all="true"/>
            </action>
            <action id="CursorAgent.NewChat" class="com.cursoragent.actions.AgentPanelAction$NewChat"
                    text="新規チャット" description="現在のパネルに新しいチャットを開きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control T"/>
                <keyboard-shortcut keymap="$default" first-keystroke="control N"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta T" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta N"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta T" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta N"/>
            </action>
            <action id="CursorAgent.ResetChat" class="com.cursoragent.actions.AgentPanelAction$ResetChat"
                    text="入力欄から新しい会話へ" description="入力欄から新しい会話へ切り替えます。元の会話と未送信の入力はチャット一覧から戻せます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control R"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta R" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta R" replace-all="true"/>
            </action>
            <action id="CursorAgent.UnfocusInput" class="com.cursoragent.actions.AgentPanelAction$UnfocusInput"
                    text="入力欄から作業場所へ戻る" description="会話を保持してエディターへ戻ります。Terminalから開いた場合は、開いているTerminalへ戻ります。">
                <keyboard-shortcut keymap="$default" first-keystroke="ESCAPE"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="ESCAPE" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ESCAPE" replace-all="true"/>
            </action>
            <action id="CursorAgent.CloseChat" class="com.cursoragent.actions.AgentPanelAction$CloseChat"
                    text="チャットを閉じる" description="現在のチャットを確認して閉じます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control W"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta W" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta W" replace-all="true"/>
            </action>
            <action id="CursorAgent.PreviousChat" class="com.cursoragent.actions.AgentPanelAction$PreviousChat"
                    text="前のチャット" description="前のタブへ移動します。タブが1つの場合は保存会話を更新日時順に移動します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control OPEN_BRACKET"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta OPEN_BRACKET" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta OPEN_BRACKET" replace-all="true"/>
            </action>
            <action id="CursorAgent.NextChat" class="com.cursoragent.actions.AgentPanelAction$NextChat"
                    text="次のチャット" description="次のタブへ移動します。タブが1つの場合は保存会話を更新日時順に移動します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control CLOSE_BRACKET"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta CLOSE_BRACKET" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta CLOSE_BRACKET" replace-all="true"/>
            </action>
            <action id="CursorAgent.PreviousAgent" class="com.cursoragent.actions.AgentPanelAction$PreviousAgent"
                    text="前のAgentへ移動" description="開いているタブを切り替えます。タブが1つの場合は保存会話を更新日時順に移動します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt LEFT"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt LEFT" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt LEFT" replace-all="true"/>
            </action>
            <action id="CursorAgent.NextAgent" class="com.cursoragent.actions.AgentPanelAction$NextAgent"
                    text="次のAgentへ移動" description="開いているタブを切り替えます。タブが1つの場合は保存会話を更新日時順に移動します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt RIGHT"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt RIGHT" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt RIGHT" replace-all="true"/>
            </action>
            <action id="CursorAgent.RecentChat" class="com.cursoragent.actions.AgentPanelAction$RecentChat"
                    text="最近使ったチャットへ切り替える" description="最近使った会話の一覧を開きます。キーを押したまま候補を選び、修飾キーを離して開きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control TAB"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control TAB" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control TAB" replace-all="true"/>
            </action>
            <action id="CursorAgent.LeastRecentChat" class="com.cursoragent.actions.AgentPanelAction$LeastRecentChat"
                    text="最近使用一覧の末尾から切り替える" description="最近使った会話の一覧を開きます。キーを押したまま候補を選び、修飾キーを離して開きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control shift TAB"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control shift TAB" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control shift TAB" replace-all="true"/>
            </action>
            <action id="CursorAgent.Stop" class="com.cursoragent.actions.AgentPanelAction$Stop"
                    text="保留要求を拒否・応答を停止" description="対象を特定できる保留要求を拒否し、保留要求がなければ現在の実行を停止します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control shift BACK_SPACE"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift BACK_SPACE" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control C"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift BACK_SPACE" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control C"/>
            </action>
            <action id="CursorAgent.AcceptPending" class="com.cursoragent.actions.AgentPanelAction$AcceptPending"
                    text="保留要求に回答" description="対象を特定できる要求を今回だけ許可、計画を承認、または選択済みの質問への回答を送信します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
                <keyboard-shortcut keymap="$default" first-keystroke="control alt ENTER"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta ENTER" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt ENTER"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta ENTER" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt ENTER"/>
            </action>
            <action id="CursorAgent.ModeMenu" class="com.cursoragent.actions.AgentPanelAction$ModeMenu"
                    text="次のModeに切り替える" description="現在のチャットをAgent・Plan・Askの順に切り替えます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control PERIOD"/>
                <keyboard-shortcut keymap="$default" first-keystroke="control alt PERIOD"/>
                <keyboard-shortcut keymap="$default" first-keystroke="shift TAB"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta PERIOD" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt PERIOD"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="shift TAB"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta PERIOD" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt PERIOD"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="shift TAB"/>
            </action>
            <action id="CursorAgent.ModelMenu" class="com.cursoragent.actions.AgentPanelAction$ModelMenu"
                    text="Modelを選ぶ" description="現在のチャットのModel選択を開きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control SLASH"/>
                <keyboard-shortcut keymap="Default for XWin" first-keystroke="control SLASH" replace-all="true"/>
                <keyboard-shortcut keymap="Default for XWin" first-keystroke="control alt SLASH"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta SLASH" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt SLASH"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta SLASH" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt SLASH"/>
            </action>
            <action id="CursorAgent.AddContext" class="com.cursoragent.actions.AgentPanelAction$AddContext"
                    text="Contextを追加" description="現在のチャットのcontext候補を開きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt P"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt P" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt P" replace-all="true"/>
            </action>
            <action id="CursorAgent.History" class="com.cursoragent.actions.AgentWindowAction$History"
                    text="チャット履歴" description="保存済みのチャットを探します。">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt QUOTE"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt QUOTE" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt QUOTE" replace-all="true"/>
            </action>
            <action id="CursorAgent.Changes" class="com.cursoragent.actions.AgentPanelAction$Changes"
                    text="変更一覧" description="現在のチャットによる変更一覧を開きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control shift R"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift R" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift R" replace-all="true"/>
            </action>
            <action id="CursorAgent.Settings" class="com.cursoragent.actions.AgentWindowAction$Settings"
                    text="Cursorの設定" description="Cursor in Android Studioの設定を開きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control shift J"/>
                <keyboard-shortcut keymap="$default" first-keystroke="control COMMA"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift J" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta COMMA"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift J" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta COMMA"/>
            </action>
            <action id="CursorAgent.QueuePrevious" class="com.cursoragent.actions.AgentQueueAction$Previous"
                    text="前の予約入力" description="予約一覧で前の項目を選びます。">
                <keyboard-shortcut keymap="$default" first-keystroke="UP"/>
            </action>
            <action id="CursorAgent.QueueNext" class="com.cursoragent.actions.AgentQueueAction$Next"
                    text="次の予約入力" description="予約一覧で次の項目を選びます。末尾では入力欄へ戻ります。">
                <keyboard-shortcut keymap="$default" first-keystroke="DOWN"/>
            </action>
            <action id="CursorAgent.QueueEdit" class="com.cursoragent.actions.AgentQueueAction$Edit"
                    text="予約入力を編集" description="予約一覧で選んだ入力を編集します。">
                <keyboard-shortcut keymap="$default" first-keystroke="RIGHT"/>
                <keyboard-shortcut keymap="$default" first-keystroke="SPACE"/>
            </action>
            <action id="CursorAgent.QueueRemove" class="com.cursoragent.actions.AgentQueueAction$Remove"
                    text="予約入力を削除" description="予約一覧で選んだ入力とその添付を取り除きます。">
                <keyboard-shortcut keymap="$default" first-keystroke="control DELETE"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta BACK_SPACE" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta BACK_SPACE" replace-all="true"/>
            </action>
            <action id="CursorAgent.QueueReturnToInput" class="com.cursoragent.actions.AgentQueueAction$ReturnToInput"
                    text="予約から入力へ戻る" description="予約一覧を離れるか、入力欄の予約編集を取り消して元の下書きへ戻ります。">
                <keyboard-shortcut keymap="$default" first-keystroke="ESCAPE"/>
            </action>
        </group>
    </actions>
</idea-plugin>
