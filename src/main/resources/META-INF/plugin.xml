<idea-plugin>
    <id>com.cursoragent.plugin</id>
    <name>Cursor Agent</name>
    <vendor email="dev@example.com">SelfRegi</vendor>
    <description><![CDATA[
        Android Studio 上で Cursor Agent CLI を利用するツールウィンドウプラグイン。
        agent -p --output-format stream-json をサブプロセス実行し、チャット UI にストリーミング表示します。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Cursor Agent" displayType="BALLOON"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.cursoragent.settings.AgentSettingsConfigurable"
                id="com.cursoragent.settings.AgentSettingsConfigurable"
                displayName="Cursor Agent"/>
        <toolWindow
                id="Cursor Agent"
                anchor="right"
                icon="/icons/cursor-agent.svg"
                factoryClass="com.cursoragent.toolwindow.CursorAgentToolWindowFactory"/>
        <projectService serviceImplementation="com.cursoragent.service.AgentProcessService"/>
        <projectService serviceImplementation="com.cursoragent.service.CheckpointService"/>
        <projectService serviceImplementation="com.cursoragent.settings.CheckpointHistoryState"/>
        <projectService serviceImplementation="com.cursoragent.settings.ChatHistoryState"/>
        <applicationService serviceImplementation="com.cursoragent.settings.AgentSettingsState"/>
    </extensions>
</idea-plugin>
