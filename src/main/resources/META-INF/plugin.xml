<idea-plugin>
    <id>com.cursoragent.plugin</id>
    <name>Cursor in Android Studio</name>
    <vendor email="dev@example.com">SelfRegi</vendor>
    <description><![CDATA[
        Use Cursor Agent inside Android Studio with an integrated chat tool window.
        Android Studio 上で Cursor Agent CLI を利用するツールウィンドウプラグイン。
        agent -p --output-format stream-json をサブプロセス実行し、チャット UI にストリーミング表示します。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Optional: Terminal mentions and copied Terminal context need this. A user who has disabled the
         bundled Terminal plugin must still be able to load and use the rest of this plugin. -->
    <depends optional="true" config-file="cursor-agent-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <!-- Keep chat and browser recovery available without a JCEF provider. -->
    <depends optional="true" config-file="cursor-agent-jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.cursoragent.ui.editor.ChatFileEditorProvider"/>
        <copyPastePostProcessor implementation="com.cursoragent.ui.composer.context.ClipboardContextCopyProcessor"/>
        <!-- Run before the platform PSI paste consumes text; only marked prompt editors are intercepted. -->
        <editorActionHandler action="EditorPaste" implementationClass="com.cursoragent.ui.composer.image.PromptImagePasteHandler" order="first"/>
        <!-- Keep persisted IDs stable when renaming the product. -->
        <notificationGroup id="Cursor Agent" displayType="BALLOON"
                           bundle="messages.CursorAgentBundle" key="notification.group.name"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.cursoragent.settings.AgentSettingsConfigurable"
                id="com.cursoragent.settings.AgentSettingsConfigurable"
                displayName="Cursor in Android Studio"/>
        <toolWindow
                id="Cursor Agent"
                anchor="right"
                icon="/icons/cursor-agent.svg"
                factoryClass="com.cursoragent.toolwindow.CursorAgentToolWindowFactory"/>
        <toolWindow
                id="Cursor Manual Browser"
                anchor="bottom"
                icon="/icons/cursor-agent.svg"
                canCloseContents="true"
                doNotActivateOnStart="true"
                factoryClass="com.cursoragent.ui.browser.ManualBrowser"/>
        <projectService serviceImplementation="com.cursoragent.service.AgentProcessService"/>
        <projectService serviceImplementation="com.cursoragent.service.CheckpointService"/>
        <projectService serviceImplementation="com.cursoragent.settings.CheckpointHistoryState"/>
        <projectService serviceImplementation="com.cursoragent.settings.ChatHistoryState"/>
        <applicationService serviceImplementation="com.cursoragent.settings.AgentSettingsState"/>
    </extensions>
    <actions>
        <action id="CursorAgent.CycleModelParameter" class="com.cursoragent.actions.CycleModelParameterAction"
                text="モデルの追加設定を切り替える (Cursor)" description="接続先が広告した先頭のモデル追加設定を順に切り替えます">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift SLASH"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt SLASH"/>
            <keyboard-shortcut keymap="Default for XWin" first-keystroke="ctrl shift SLASH" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift SLASH" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift SLASH" replace-all="true"/>
        </action>
        <action id="CursorAgent.ToggleChatEditor" class="com.cursoragent.ui.editor.ChatEditorToggleAction"
                text="会話のパネル／エディター表示を切り替える" description="同じ会話・下書き・実行を保持したまま表示先を切り替えます。">
            <keyboard-shortcut keymap="$default" first-keystroke="control D"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta D"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta D"/>
        </action>
        <action id="CursorAgent.PastePlain" class="com.cursoragent.ui.composer.context.PromptPlainPasteAction"
                text="入力欄へ本文として貼り付ける" description="コピー元のcontextを添付せず、テキストを入力欄へ貼り付けます。">
            <keyboard-shortcut keymap="$default" first-keystroke="control shift V"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift V" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift V" replace-all="true"/>
        </action>
        <action id="CursorAgent.AddSelectionToChat" class="com.cursoragent.actions.AddSelectionToChatAction"
                text="Add to Chat (Cursor)" description="選択したコードを現在のチャットへ明示contextとして追加します。">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
