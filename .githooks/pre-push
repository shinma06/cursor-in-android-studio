#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mode="$(python3 scripts/workflow/git_guard.py push)"
if [ "$mode" = skip ]; then exit 0; fi
# Git exports repository-local variables into hooks. Tests create foreign repos;
# clear these before any tests/Gradle so git init cannot target the source repo.
while IFS= read -r git_variable; do
  unset "$git_variable"
done < <(git rev-parse --local-env-vars)
if [ -z "${JAVA_HOME:-}" ] && [ -x /usr/libexec/java_home ]; then
  JAVA_HOME="$(/usr/libexec/java_home -v 17)"
  export JAVA_HOME
fi
if [ -f scripts/workflow/change_impact.py ]; then
  python3 scripts/workflow/change_impact.py --run-tests
else
  # A trusted hook can guard an older enrolled branch without the classifier.
  echo 'Change Impact: unknown (legacy branch); run full tests'
  python3 -m unittest discover -s scripts/workflow -p 'test_*.py'
  python3 -m unittest discover -s scripts/loop -p 'test_*.py'
  ./gradlew test --console=plain
fi
